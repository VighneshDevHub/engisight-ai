# --- App ---
APP_NAME=EngiSight AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated for Pydantic list parsing: e.g. http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Database ---
POSTGRES_USER=eda_user
POSTGRES_PASSWORD=eda_password
POSTGRES_DB=eda_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://eda_user:eda_password@postgres:5432/eda_db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_DRAWINGS=drawings
MINIO_SECURE=false

# --- Qdrant (vector store) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LLM Provider — Groq only (per build spec; single provider) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
# Production flagship text model (verified 2026-08-09 against Groq docs).
#   * llama-3.3-70b-versatile is DEPRECATED — decommissioning 2026-08-16.
#   * Current flagship: openai/gpt-oss-120b (Production tier, ~500 tps).
# Re-check https://console.groq.com/docs/models before any prod release.
GROQ_MODEL=openai/gpt-oss-120b
# Preview-tier vision model (ONLY vision-capable Groq model: qwen/qwen3.6-27b).
# For non-reasoning / classification tasks, ALWAYS pass:
#   model_kwargs={"reasoning_effort": "none"}
# or the Qwen model will wrap output in <think> tags and break JSON parsing.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
