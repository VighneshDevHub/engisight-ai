# --- App ---
APP_NAME=EngineeringDocAI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
POSTGRES_USER=eda_user
POSTGRES_PASSWORD=eda_password
POSTGRES_DB=eda_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://eda_user:eda_password@postgres:5432/eda_db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_DRAWINGS=drawings
MINIO_SECURE=false

# --- Qdrant (vector store) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LLM Provider (LangChain, provider-agnostic) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback vision-capable provider (used only if a step needs direct image reasoning)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
